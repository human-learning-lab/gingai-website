rules_version = '2';

/*
 * The app authenticates with Clerk, so `request.auth` is never populated and
 * no client-side rule could distinguish a sailor from anyone on the internet.
 * Everything therefore goes through a Clerk-gated /api route using the Admin
 * SDK, which bypasses these rules.
 *
 * Denying everything here is the security model, not a placeholder. Do not
 * relax it without first bridging Clerk into Firebase custom tokens.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
